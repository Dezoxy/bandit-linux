root = true

[*]
charset = utf-8
end_of_line = lf
insert_final_newline = true
trim_trailing_whitespace = true

[*.sh]
indent_style = space
indent_size = 2

[*.py]
indent_style = space
indent_size = 4

[*.go]
indent_style = tab
indent_size = 4

[*.java]
indent_style = space
indent_size = 4

[*.kt]
indent_style = space
indent_size = 4

[*.{js,mjs,cjs,json}]
indent_style = space
indent_size = 4

[*.{cs,csproj}]
indent_style = space
indent_size = 4

[*.rs]
indent_style = space
indent_size = 4

[*.rb]
indent_style = space
indent_size = 2

[Gemfile]
indent_style = space
indent_size = 2

[*.{pl,t}]
indent_style = space
indent_size = 4

[*.swift]
indent_style = space
indent_size = 4

[*.ts]
indent_style = space
indent_size = 4

[*.zig]
indent_style = space
indent_size = 4

[*.{c,h}]
indent_style = space
indent_size = 4

[*.toml]
indent_style = space
indent_size = 2

[*.md]
indent_style = space
indent_size = 2
trim_trailing_whitespace = false
